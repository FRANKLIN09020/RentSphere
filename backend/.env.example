# RentSphere Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars-long
JWT_EXPIRATION_MS=36000000

# Send the auth cookie only over HTTPS (set to true in production)
JWT_COOKIE_SECURE=false

# Database - Development (H2, defaults work out of the box)
# No DB env vars needed for dev profile (uses H2)

# Database - Production (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/rentsphere
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DRIVER=org.postgresql.Driver
JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Mail
MAIL_ENABLED=false
MAIL_FROM=noreply@rentsphere.local
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# Groq AI (gpt-oss-20b)
GROQ_API_KEY=your-groq-api-key-here

# Razorpay (test mode: get keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_your-test-key-id
RAZORPAY_KEY_SECRET=your-test-key-secret
# Optional but recommended - used to verify async webhook calls from Razorpay
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Local Admin (dev only)
LOCAL_ADMIN_EMAIL=admin@rentsphere.local
LOCAL_ADMIN_PASSWORD=RentSphere@2026
