Enum user_role {
  ADMIN
  OWNER
  TENANT
}

Enum unit_status {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

Enum agreement_status {
  ACTIVE
  EXPIRED
  TERMINATED
}

Enum invoice_status {
  PENDING
  PAID
  OVERDUE
}

Enum payment_status {
  PENDING
  SUCCESS
  FAILED
}

Enum complaint_status {
  OPEN
  IN_PROGRESS
  RESOLVED
}

Enum deposit_dispute_status {
  OPEN
  EVIDENCE_PENDING
  UNDER_REVIEW
  SETTLEMENT_PROPOSED
  SETTLED
  REJECTED
}

Enum rent_increase_status {
  DRAFT
  NOTICE_SCHEDULED
  NOTIFIED
  TENANT_REVIEW
  ACCEPTED
  DISPUTED
  CANCELLED
}

Table organizations {
  id uuid [pk]
  name text [not null]
  address text
  phone text
  email text
  created_at timestamp
  updated_at timestamp
}

Table users {
  id uuid [pk]
  organization_id uuid
  name text [not null]
  email text [unique, not null]
  password text [not null]
  role user_role [default: 'TENANT']
  phone text
  created_at timestamp
  updated_at timestamp
}

Table properties {
  id uuid [pk]
  organization_id uuid
  owner_id uuid
  name text [not null]
  address text [not null]
  city text
  state text
  amenities text
  image_url text
  created_at timestamp
  updated_at timestamp
}

Table buildings {
  id uuid [pk]
  organization_id uuid
  property_id uuid
  name text [not null]
  floors int
  created_at timestamp
  updated_at timestamp
}

Table units {
  id uuid [pk]
  organization_id uuid
  building_id uuid
  unit_number text [not null]
  rent_amount decimal [not null]
  status unit_status [default: 'AVAILABLE']
  created_at timestamp
  updated_at timestamp
}

Table tenants {
  id uuid [pk]
  organization_id uuid
  user_id uuid
  unit_id uuid
  full_name text
  phone text
  emergency_contact text
  kyc_status text
  id_proof_url text
  address_proof_url text
  created_at timestamp
  updated_at timestamp
}

Table agreements {
  id uuid [pk]
  organization_id uuid
  tenant_id uuid
  unit_id uuid
  start_date date
  end_date date
  rent_amount decimal
  status agreement_status [default: 'ACTIVE']
  created_at timestamp
  updated_at timestamp
}

Table invoices {
  id uuid [pk]
  organization_id uuid
  tenant_id uuid
  agreement_id uuid
  amount decimal [not null]
  due_date date
  status invoice_status [default: 'PENDING']
  created_at timestamp
  updated_at timestamp
}

Table payments {
  id uuid [pk]
  organization_id uuid
  invoice_id uuid
  amount decimal [not null]
  status payment_status [default: 'PENDING']
  payment_date timestamp
  created_at timestamp
  updated_at timestamp
}

Table complaints {
  id uuid [pk]
  organization_id uuid
  tenant_id uuid
  unit_id uuid
  title text
  description text
  status complaint_status [default: 'OPEN']
  created_at timestamp
  updated_at timestamp
}

Table deposit_disputes {
  id uuid [pk]
  organization_id uuid
  tenant_id uuid
  unit_id uuid
  agreement_id uuid
  deposit_amount decimal
  deducted_amount decimal
  owner_repair_estimate decimal
  market_repair_estimate decimal
  proposed_settlement_amount decimal
  deduction_reason text
  evidence_url text
  tenant_notes text
  owner_response text
  settlement_due_date date
  status deposit_dispute_status [default: 'OPEN']
  created_at timestamp
  updated_at timestamp
}

Table rent_increases {
  id uuid [pk]
  organization_id uuid
  tenant_id uuid
  unit_id uuid
  agreement_id uuid
  previous_rent decimal
  proposed_rent decimal
  increase_amount decimal
  increase_percent decimal
  notice_date date
  effective_date date
  notification_scheduled_at timestamp
  notification_sent_at timestamp
  reason text
  tenant_response text
  owner_notes text
  status rent_increase_status [default: 'DRAFT']
  created_at timestamp
  updated_at timestamp
}

Ref: users.organization_id > organizations.id

Ref: properties.organization_id > organizations.id
Ref: properties.owner_id > users.id

Ref: buildings.organization_id > organizations.id
Ref: buildings.property_id > properties.id

Ref: units.organization_id > organizations.id
Ref: units.building_id > buildings.id

Ref: tenants.organization_id > organizations.id
Ref: tenants.user_id > users.id
Ref: tenants.unit_id > units.id

Ref: agreements.organization_id > organizations.id
Ref: agreements.tenant_id > tenants.id
Ref: agreements.unit_id > units.id

Ref: invoices.organization_id > organizations.id
Ref: invoices.tenant_id > tenants.id
Ref: invoices.agreement_id > agreements.id

Ref: payments.organization_id > organizations.id
Ref: payments.invoice_id > invoices.id

Ref: complaints.organization_id > organizations.id
Ref: complaints.tenant_id > tenants.id
Ref: complaints.unit_id > units.id

Ref: deposit_disputes.organization_id > organizations.id
Ref: deposit_disputes.tenant_id > tenants.id
Ref: deposit_disputes.unit_id > units.id
Ref: deposit_disputes.agreement_id > agreements.id

Ref: rent_increases.organization_id > organizations.id
Ref: rent_increases.tenant_id > tenants.id
Ref: rent_increases.unit_id > units.id
Ref: rent_increases.agreement_id > agreements.id
